<Configuration>
<appenders>

<File name="FileAppender" fileName="logs/application.log"></File>

<Console name="CONSOLE" target="SYSTEM_OUT">

<PatternLayout pattern="%d [%t] %highlight{%5p} %c - %m%n"></PatternLayout>

</Console>



</appenders>
<loggers>
<root level="info">
<AppenderRef ref="CONSOLE"></AppenderRef>
<AppenderRef ref="FileAppender"></AppenderRef>

</root>

</loggers>
</Configuration>